# Required. 32+ random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Public URL of this app (used for Google redirects and CORS). Comma-separate extra origins.
PUBLIC_ORIGIN=http://localhost:3000
# Teacher app URL (Google sign-in returns here for teachers).
TEACHER_ORIGIN=http://localhost:4173
# Only roster emails on these domains can sign in.
ALLOWED_EMAIL_DOMAINS=gmail.com
# Set to 1 on Render / behind a reverse proxy.
TRUST_PROXY=0

# Google OAuth (Web application client). Redirect URI: ${PUBLIC_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# EmailJS for sign-in codes. Template variables: to_email, to_name, otp, expires_minutes, purpose
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Local development only: print codes to the console instead of emailing. Ignored when FLASK_ENV=production.
AUTH_DEV_LOG_CODES=0

# Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
# Supabase / PostgreSQL Connection URI
DATABASE_URL=
