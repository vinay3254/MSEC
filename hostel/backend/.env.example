# Application Settings
PROJECT_NAME="MSEC Hostel Management System API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security & Authentication
# Generate a secure random secret in production (e.g. `openssl rand -hex 32`)
SECRET_KEY="msec-super-secret-jwt-signing-key-for-hostel-dashboard-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
# Use SQLite for zero-config quickstart, or PostgreSQL for production:
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/msec_hostel"
DATABASE_URL="sqlite:///./hostel_management.db"

# CORS Configuration (JSON array of strings)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
